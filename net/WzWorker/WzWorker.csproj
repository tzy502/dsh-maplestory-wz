<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>wzworker</AssemblyName>
    <RootNamespace>WzWorker</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- WzComparerR2 的 WzLib（MIT）。随插件分发，见 vendor/WZCOMPARERR2-LICENSE。 -->
    <Reference Include="WzComparerR2.WzLib">
      <HintPath>../../vendor/WzComparerR2.WzLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
