# Python
__pycache__/
*.py[cod]

# 编辑器 / 系统
.DS_Store
*.swp

# 插件产物不进仓库（落在 ~/.dsh/wz-assets/ 与 ~/.dsh/desktop-pet/，本来就在仓库外）
*.png
!icon.svg
# 但 README / 插件市场要用的截图必须进仓库
!docs/screenshots/*.png

# 验收脚本的临时输出
/tmp/

# .NET worker 的构建产物（由 net/WzWorker 自行 dotnet build 生成）
net/WzWorker/bin/
net/WzWorker/obj/
# dist/ 是随包发布的预编译产物，必须进仓库
!net/WzWorker/dist/
